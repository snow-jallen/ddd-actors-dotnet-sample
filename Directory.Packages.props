<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AkkaVersion>1.5.73</AkkaVersion>
  </PropertyGroup>

  <!--
    Every package version used anywhere in the sample is pinned here, and a PackageReference
    never carries a Version attribute. A PackageVersion arrives in the same commit as the first
    project that references it.
  -->

  <!-- Every Akka.* package uses Version="$(AkkaVersion)", so an upgrade is a one-line change. -->
  <ItemGroup Label="Akka.NET">
    <PackageVersion Include="Akka" Version="$(AkkaVersion)" />
    <!-- Brings Akka.Cluster, Akka.Cluster.Sharding, Akka.Cluster.Tools and Akka.Remote.Hosting. -->
    <PackageVersion Include="Akka.Cluster.Hosting" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Hosting" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Persistence.Hosting" Version="$(AkkaVersion)" />
    <!-- Not the deprecated Akka.Persistence.Sqlite/.PostgreSql/.SqlServer plugins. -->
    <PackageVersion Include="Akka.Persistence.Sql.Hosting" Version="$(AkkaVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hosting and Aspire">
  </ItemGroup>

  <ItemGroup Label="Data">
    <!-- 10.0.0 pulls in a vulnerable SQLitePCLRaw; 10.0.14 does not. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Telemetry and operations">
  </ItemGroup>

  <ItemGroup Label="Mobile">
  </ItemGroup>

  <ItemGroup Label="Build and release">
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Akka.Persistence.TestKit.Xunit" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.TestKit.Xunit" Version="$(AkkaVersion)" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
