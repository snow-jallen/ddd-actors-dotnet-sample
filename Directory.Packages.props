<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AkkaVersion>1.5.73</AkkaVersion>
  </PropertyGroup>

  <!--
    Every package version used anywhere in the sample is pinned here, and a PackageReference
    never carries a Version attribute. A PackageVersion arrives in the same commit as the first
    project that references it.
  -->

  <!-- Every Akka.* package uses Version="$(AkkaVersion)", so an upgrade is a one-line change. -->
  <ItemGroup Label="Akka.NET">
    <PackageVersion Include="Akka" Version="$(AkkaVersion)" />
    <!-- Brings Akka.Cluster, Akka.Cluster.Sharding, Akka.Cluster.Tools and Akka.Remote.Hosting. -->
    <PackageVersion Include="Akka.Cluster.Hosting" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Hosting" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Persistence.Hosting" Version="$(AkkaVersion)" />
    <!-- Not the deprecated Akka.Persistence.Sqlite/.PostgreSql/.SqlServer plugins. -->
    <PackageVersion Include="Akka.Persistence.Sql.Hosting" Version="$(AkkaVersion)" />
    <!-- The read side of the in-memory journal: fast projection runner tests (section 14.7). -->
    <PackageVersion Include="Akka.Persistence.Query.InMemory" Version="$(AkkaVersion)" />
    <!-- On Kubernetes (section 21.6): cluster bootstrap over Akka.Management's HTTP endpoint,
         contact points from the Kubernetes API, and a lease for the split-brain resolver. -->
    <PackageVersion Include="Akka.Coordination.KubernetesApi" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Discovery.KubernetesApi" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Management" Version="$(AkkaVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hosting and Aspire">
    <!-- Aspire.Hosting.AppHost is not here: Aspire.AppHost.Sdk/13.6.4 references it implicitly,
         at its own version, and NU1009 forbids a PackageVersion for an implicit reference. -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <!-- The PostgreSQL driver Akka.Persistence.Sql loads for ProviderName.PostgreSQL15. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- 10.0.0 pulls in a vulnerable SQLitePCLRaw; 10.0.14 does not. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- The migrator that owns the schema of Ohmline's databases (section 20.8). -->
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup Label="Telemetry and operations">
    <!-- The OpenTelemetry SDK, in Ohmline.ServiceDefaults only: every other project speaks the
         BCL's ActivitySource and Meter (section 17.1). Akka.Hosting already asks for
         OpenTelemetry >= 1.12.0; these pins lift every host to 1.20.1. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- Operators' commands for a running cluster (pbm), bound to loopback (section 18.8). -->
    <PackageVersion Include="Petabridge.Cmd.Cluster" Version="1.5.2" />
    <PackageVersion Include="Petabridge.Cmd.Cluster.Sharding" Version="1.5.2" />
    <PackageVersion Include="Petabridge.Cmd.Host" Version="1.5.2" />
    <!-- Feature flags, evaluated by the node's host and never by an actor (section 21.8). -->
    <PackageVersion Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup Label="Mobile">
    <!-- Source generators for the app's view models: observable partial properties, commands. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The MAUI head only. $(MauiVersion) of the installed workload: there is no MAUI rc.3,
         and the rc.3 SDK's workload set ships MAUI rc.2. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.0-rc.2.26505.5" />
    <!-- The MAUI head only; the template floats 11.0.0-*, pinned here for reproducible tags. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>

  <ItemGroup Label="Build and release">
    <!-- Versions from vX.Y.Z git tags, in every project (Directory.Build.props, section 21.2). -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- A real host with DI and the actor registry in a test; 1.5.68+ for parallel xUnit v3 runs. -->
    <PackageVersion Include="Akka.Hosting.TestKit" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Persistence.TestKit.Xunit" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.TestKit.Xunit" Version="$(AkkaVersion)" />
    <!-- Spans exported into a list, for assertions on whole traces (section 17.8). -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <!-- The whole AppHost in a test: containers, processes and their endpoints (16.9). -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <!-- The RC that matches the SDK: WebApplicationFactory for the net11.0 node. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <!-- The hub's .NET client: the integration tests now, the driver app from Chapter 19. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-rc.3.26522.148" />
    <!-- MetricCollector<T>: one instrument of one meter factory's meters (18.3). -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- PostgreSQL 17 in a container, for the integration tests; Podman works with DOCKER_HOST. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.XunitV3" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
