<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AkkaVersion>1.5.73</AkkaVersion>
  </PropertyGroup>

  <!--
    Every package version used anywhere in the sample is pinned here, and a PackageReference
    never carries a Version attribute. A PackageVersion arrives in the same commit as the first
    project that references it.
  -->

  <!-- Every Akka.* package uses Version="$(AkkaVersion)", so an upgrade is a one-line change. -->
  <ItemGroup Label="Akka.NET">
    <PackageVersion Include="Akka" Version="$(AkkaVersion)" />
    <PackageVersion Include="Akka.Hosting" Version="$(AkkaVersion)" />
  </ItemGroup>

  <ItemGroup Label="Hosting and Aspire">
  </ItemGroup>

  <ItemGroup Label="Data">
  </ItemGroup>

  <ItemGroup Label="Telemetry and operations">
  </ItemGroup>

  <ItemGroup Label="Mobile">
  </ItemGroup>

  <ItemGroup Label="Build and release">
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Akka.TestKit.Xunit" Version="$(AkkaVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
