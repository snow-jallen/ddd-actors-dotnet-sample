<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- LangVersion is deliberately not set: net11.0 defaults to C# 15. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Exhaustiveness is not negotiable, even when someone turns TreatWarningsAsErrors off
         locally. CS8509: a switch expression misses a case. CS8655: it misses null. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509;CS8655;nullable</WarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <!-- Reproducible old tags: the vulnerability audit runs as a separate CI job (ch21-s04),
         not in every build. -->
    <NuGetAudit>false</NuGetAudit>
    <!-- Every project's resolved package graph, committed as packages.lock.json: CI restores in
         locked mode and fails if a restore would resolve anything else (section 21.4). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- What every package Ohmline publishes says about itself. Only the published contracts are
       packed (section 21.1); every other project keeps IsPackable false. -->
  <PropertyGroup>
    <Authors>Ohmline</Authors>
    <Company>Ohmline</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!--
    Versions come from git (section 21.2): MinVer reads the latest vX.Y.Z tag, so a release is a
    tag and never an edit. The book's chNN-sMM tags have no v, and MinVer ignores them.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
