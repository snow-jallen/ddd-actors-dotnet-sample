<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (MainApplication.cs): plain HTTP to the development machine's node, as
     the Android emulator sees it. Every other address keeps Android's HTTPS-only default. -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
