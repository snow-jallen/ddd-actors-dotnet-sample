<Project>
  <!-- Build checks that run after every project file has been read. -->
  <Import Project="$(MSBuildThisFileDirectory)build/DomainPurity.targets" />

  <!--
    WRONG (section 21.2): the assembly version is stuck at MAJOR.0.0.0 under MinVer, so give the
    cluster MinVer's whole version instead. Between releases that is a dotted pre-release such
    as 0.0.0-alpha.0.165, which Akka.NET cannot parse: the node does not start.
  -->
  <Target Name="OhmlineAppVersion" AfterTargets="MinVer">
    <ItemGroup>
      <AssemblyMetadata Include="OhmlineAppVersion" Value="$(MinVerVersion)" />
    </ItemGroup>
  </Target>
</Project>
