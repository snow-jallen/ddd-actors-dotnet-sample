<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Charging's model: events, state and deciders. Pure: the shared kernel, Charging's own
    contracts, the contracts of the contexts it conforms to (Tariffs' tariff snapshot; Site
    Energy's and Driver Accounts' replies, which the charging journey reacts to) and the base
    class library only, and no package references.
  -->

  <ItemGroup>
    <ProjectReference Include="../../Ohmline.SharedKernel/Ohmline.SharedKernel.csproj" />
    <ProjectReference Include="../Ohmline.Charging.Contracts/Ohmline.Charging.Contracts.csproj" />
    <ProjectReference
      Include="../../Tariffs/Ohmline.Tariffs.Contracts/Ohmline.Tariffs.Contracts.csproj" />
    <ProjectReference
      Include="../../SiteEnergy/Ohmline.SiteEnergy.Contracts/Ohmline.SiteEnergy.Contracts.csproj" />
    <ProjectReference
      Include="../../DriverAccounts/Ohmline.DriverAccounts.Contracts/Ohmline.DriverAccounts.Contracts.csproj" />
  </ItemGroup>

</Project>
