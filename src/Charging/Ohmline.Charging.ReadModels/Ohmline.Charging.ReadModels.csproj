<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Charging's read side: projections from the journal, the offset store and the outbox
    relay. It reads Charging's events; it never decides anything.
  -->

  <ItemGroup>
    <!-- The read journal (SqlReadJournal) over the tables the actors write, and Akka.Streams. -->
    <PackageReference Include="Akka.Persistence.Sql.Hosting" />
    <!-- Sharded daemon processes: one projector per projection stream in the cluster. -->
    <PackageReference Include="Akka.Cluster.Hosting" />
    <!-- The read models' own tables and the projection offsets, in PostgreSQL. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ohmline.Charging.Domain/Ohmline.Charging.Domain.csproj" />
    <ProjectReference Include="../Ohmline.Charging.Contracts/Ohmline.Charging.Contracts.csproj" />
    <ProjectReference Include="../../Ohmline.ActorShell/Ohmline.ActorShell.csproj" />
    <!--
      Site Energy's published view of its allocation events, for the site live board, and its
      commands, which the session-ended subscriber sends (section 15.1).
    -->
    <ProjectReference
      Include="../../SiteEnergy/Ohmline.SiteEnergy.Contracts/Ohmline.SiteEnergy.Contracts.csproj" />
    <!-- Driver Accounts' commands, which the session-ended subscriber sends (section 15.1). -->
    <ProjectReference
      Include="../../DriverAccounts/Ohmline.DriverAccounts.Contracts/Ohmline.DriverAccounts.Contracts.csproj" />
  </ItemGroup>

</Project>
