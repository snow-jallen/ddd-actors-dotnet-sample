<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Charging's read side: projections from the journal, the offset store and the outbox
    relay. It reads Charging's events; it never decides anything.
  -->

  <ItemGroup>
    <!-- The read journal (SqlReadJournal) over the tables the actors write, and Akka.Streams. -->
    <PackageReference Include="Akka.Persistence.Sql.Hosting" />
    <!-- The read models' own tables and the projection offsets, in PostgreSQL. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ohmline.Charging.Domain/Ohmline.Charging.Domain.csproj" />
    <ProjectReference Include="../Ohmline.Charging.Contracts/Ohmline.Charging.Contracts.csproj" />
    <ProjectReference Include="../../Ohmline.ActorShell/Ohmline.ActorShell.csproj" />
  </ItemGroup>

</Project>
