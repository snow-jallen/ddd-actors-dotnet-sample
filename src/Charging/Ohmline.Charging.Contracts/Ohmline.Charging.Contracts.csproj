<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The commands that other parts of Ohmline send to Charging's aggregates: the Device Gateway,
    the HTTP edge and the charging journey. Contracts reference the shared kernel and the
    published contracts of upstream contexts: a session starts with Tariffs' tariff snapshot
    (Customer/Supplier, section 8.2). Nothing else.
  -->

  <!--
    A package for the teams that send these commands (ADR 0016): strict SemVer on its public API,
    which package validation checks on every pack against the last published version.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Commands, replies and integration events of Ohmline's Charging.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Ohmline.SharedKernel/Ohmline.SharedKernel.csproj" />
    <ProjectReference
      Include="../../Tariffs/Ohmline.Tariffs.Contracts/Ohmline.Tariffs.Contracts.csproj" />
  </ItemGroup>

</Project>
