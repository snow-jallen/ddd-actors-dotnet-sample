<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Charging's Published Language for client apps (section 19.2): the plain DTOs the driver app
    sends and reads over /app/v1 and the hub, and the source-generated JSON context for them.
    It references nothing, not even the shared kernel: the server's Shared Kernel is not the
    phone's, and whatever is referenced here ships in every app package. AOT-compatible, so the
    trimming and AOT analyzers check it on every build.
  -->

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Packed for client teams (ADR 0016). Its fourth audience is the app builds already in the
    stores, which the server keeps serving: package validation catches a breaking change to the
    API; the golden files in Ohmline.ContractTests catch one to the JSON.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>The plain DTOs and JSON context of Charging's /app/v1 client API.</Description>
  </PropertyGroup>

</Project>
