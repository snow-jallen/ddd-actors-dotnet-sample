<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <!--
    Ohmline on a laptop: PostgreSQL 17 in a container, three replicas of the node, which form
    one cluster, Billing and the TallyPay stand-in, the Device Gateway and a charger simulator,
    the Northgate Grid stand-in, with the Aspire dashboard. Run it with "aspire run" in this folder, or with "dotnet run"
    and this project (Podman or Docker must be running).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>ohmline-apphost</UserSecretsId>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ohmline.Migrator/Ohmline.Migrator.csproj" />
    <ProjectReference Include="../Ohmline.Node/Ohmline.Node.csproj" />
    <ProjectReference Include="../Billing/Ohmline.Billing/Ohmline.Billing.csproj" />
    <ProjectReference Include="../../tools/Ohmline.FakePsp/Ohmline.FakePsp.csproj" />
    <ProjectReference
      Include="../DeviceGateway/Ohmline.DeviceGateway/Ohmline.DeviceGateway.csproj" />
    <ProjectReference Include="../../tools/Ohmline.Simulator/Ohmline.Simulator.csproj" />
    <ProjectReference
      Include="../../tools/Ohmline.FakeGridOperator/Ohmline.FakeGridOperator.csproj" />
  </ItemGroup>

</Project>
