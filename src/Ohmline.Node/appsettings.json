{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Akka": "Information"
    }
  },
  "AllowedHosts": "*",
  "feature_management": {
    "feature_flags": [
      {
        "id": "DynamicIdleFee",
        "enabled": false,
        "telemetry": {
          "enabled": true
        }
      }
    ]
  },
  "Ohmline": {
    "Charging": {
      "AskTimeout": "00:00:05"
    },
    "SiteEnergy": {
      "AskTimeout": "00:00:05"
    },
    "DriverAccounts": {
      "AskTimeout": "00:00:05"
    },
    "ReadModels": {
      "ReadYourWritesTimeout": "00:00:02",
      "SessionHistoryVersion": 1
    },
    "Projections": {
      "RefreshInterval": "00:00:00.100",
      "QueryDelay": "00:00:00.100"
    }
  },
  "Akka": {
    "Remote": {
      "Hostname": "localhost",
      "Port": 4053
    },
    "Cluster": {
      "SeedNodes": []
    }
  }
}
