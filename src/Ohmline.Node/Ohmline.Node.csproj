<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The node that runs Ohmline's actors: the composition root. It adds each bounded context's
    actors to one ActorSystem with that context's AddXxxContext() extension, and owns what
    every context shares: the clock, logging, configuration, the journal and the cluster. It
    holds no domain logic of its own.
  -->

  <!-- Its container image, ohmline/node (section 21.5, build/Containers.targets). -->
  <PropertyGroup>
    <ContainerRepository>ohmline/node</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Cluster.Hosting" />
    <PackageReference Include="Akka.Persistence.Hosting" />
    <PackageReference Include="Akka.Persistence.Sql.Hosting" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Feature flags for the deciders, evaluated outside the actors (section 21.8). -->
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <!-- PostgreSQL, when ConnectionStrings:ohmline is set (sections 12.10 and 13.6). -->
    <PackageReference Include="Npgsql" />
    <!-- pbm's host and its cluster and sharding palettes, for operators (section 18.8). -->
    <PackageReference Include="Petabridge.Cmd.Cluster" />
    <PackageReference Include="Petabridge.Cmd.Cluster.Sharding" />
    <PackageReference Include="Petabridge.Cmd.Host" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ohmline.ServiceDefaults/Ohmline.ServiceDefaults.csproj" />
    <ProjectReference
      Include="../Charging/Ohmline.Charging.Actors/Ohmline.Charging.Actors.csproj" />
    <ProjectReference Include="../Charging/Ohmline.Charging.Api/Ohmline.Charging.Api.csproj" />
    <ProjectReference
      Include="../Charging/Ohmline.Charging.ReadModels/Ohmline.Charging.ReadModels.csproj" />
    <ProjectReference
      Include="../SiteEnergy/Ohmline.SiteEnergy.Actors/Ohmline.SiteEnergy.Actors.csproj" />
    <ProjectReference
      Include="../SiteEnergy/Ohmline.SiteEnergy.Api/Ohmline.SiteEnergy.Api.csproj" />
    <ProjectReference
      Include="../SiteEnergy/Ohmline.SiteEnergy.Acl.GridOperator/Ohmline.SiteEnergy.Acl.GridOperator.csproj" />
    <ProjectReference
      Include="../DriverAccounts/Ohmline.DriverAccounts.Actors/Ohmline.DriverAccounts.Actors.csproj" />
    <ProjectReference
      Include="../DriverAccounts/Ohmline.DriverAccounts.Api/Ohmline.DriverAccounts.Api.csproj" />
    <ProjectReference Include="../Tariffs/Ohmline.Tariffs.Actors/Ohmline.Tariffs.Actors.csproj" />
  </ItemGroup>

</Project>
