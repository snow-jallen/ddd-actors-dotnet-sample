{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ohmline": {
    "Gateway": {
      "TariffId": "slc-standard",
      "SpendCap": 50,
      "AskTimeout": "00:00:05",
      "CallTimeout": "00:00:30",
      "SilenceTimeout": "00:03:00"
    }
  },
  "Akka": {
    "Remote": {
      "Hostname": "localhost",
      "Port": 4060
    },
    "Cluster": {
      "SeedNodes": []
    }
  }
}
