<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The actor shell's reusable parts: the decider actor base, serialization, sharding and
    tracing helpers. It knows the shared kernel and Akka.NET, and no bounded context.
  -->

  <ItemGroup>
    <PackageReference Include="Akka" />
    <!-- For Akka.Persistence (DeciderActor). Akka.Persistence is not pinned on its own in
         Directory.Packages.props; it comes, at the same version, with the hosting package. -->
    <PackageReference Include="Akka.Persistence.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ohmline.SharedKernel/Ohmline.SharedKernel.csproj" />
  </ItemGroup>

</Project>
