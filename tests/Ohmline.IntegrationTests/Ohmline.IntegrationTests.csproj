<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The node as it runs, against a real PostgreSQL 17 in a container: WebApplicationFactory
    starts Program in memory, and Testcontainers starts the database once for the whole
    assembly. Every test here carries [Trait("Category", "Integration")] and needs Podman or
    Docker (with rootless Podman, export DOCKER_HOST first).
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ohmline.Node/Ohmline.Node.csproj" />
    <!-- The driver app's live updates client, against the node's hub (section 19.7). -->
    <ProjectReference Include="../../src/Mobile/Ohmline.Mobile.Core/Ohmline.Mobile.Core.csproj" />
    <!-- The journal read by hand, on PostgreSQL (section 20.1). -->
    <ProjectReference Include="../../tools/Ohmline.JournalInspect/Ohmline.JournalInspect.csproj" />
  </ItemGroup>

</Project>
