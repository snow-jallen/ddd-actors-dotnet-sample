<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Charging's read side against real journals: the read journal over a temporary SQLite file,
    written by Charging's own actors and taggers (section 13.3), and projections into a
    PostgreSQL 17 container, a database per test (section 13.4).
  -->

  <ItemGroup>
    <!-- The generic host, to start Charging as the node does. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Persistence.Sql.Hosting" />
    <!-- The in-memory journal's read side, for runner tests without SQLite (section 14.7). -->
    <PackageReference Include="Akka.Persistence.Query.InMemory" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- PostgreSQL for the read models and offsets: [Trait("Category", "Integration")] only. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="../../src/Charging/Ohmline.Charging.ReadModels/Ohmline.Charging.ReadModels.csproj" />
    <!-- Only to write events the way the node does: through the shard regions. -->
    <ProjectReference
      Include="../../src/Charging/Ohmline.Charging.Actors/Ohmline.Charging.Actors.csproj" />
    <!-- Site Energy's events, to feed the site live board by hand. -->
    <ProjectReference
      Include="../../src/SiteEnergy/Ohmline.SiteEnergy.Domain/Ohmline.SiteEnergy.Domain.csproj" />
    <ProjectReference Include="../Ohmline.Testing/Ohmline.Testing.csproj" />
    <!-- The schema, as the migrator makes it before any node or service starts (20.8). -->
    <ProjectReference Include="../../src/Ohmline.Migrator/Ohmline.Migrator.csproj" />
  </ItemGroup>

</Project>
