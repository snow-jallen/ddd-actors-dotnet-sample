<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Charging's application services, called as the endpoints call them, with a test probe in
    place of each shard region. No HTTP server: the handlers are plain methods that return
    typed results.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka.TestKit.Xunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="../../src/Charging/Ohmline.Charging.Api/Ohmline.Charging.Api.csproj" />
    <!-- Charging's serializer: what the edge sends must make the trip across the cluster. -->
    <ProjectReference
      Include="../../src/Charging/Ohmline.Charging.Actors/Ohmline.Charging.Actors.csproj" />
    <ProjectReference Include="../Ohmline.Testing/Ohmline.Testing.csproj" />
  </ItemGroup>

</Project>
