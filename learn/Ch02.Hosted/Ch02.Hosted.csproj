    <Compile Include="../Ch02.AkkaBasics.Tests/Chargers/*.cs"
             Exclude="../Ch02.AkkaBasics.Tests/Chargers/*Tests.cs"
             LinkBase="Chargers" />
  </ItemGroup>

</Project>
