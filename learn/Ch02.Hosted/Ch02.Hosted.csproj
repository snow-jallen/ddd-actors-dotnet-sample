<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Akka.Hosting" />
  </ItemGroup>

  <!-- Chapter 2's actors live in its learning tests. This host compiles the same ChargerTwin
       source files instead of referencing a test project. -->
